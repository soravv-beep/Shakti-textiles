# ─────────────────────────────────────────────────────────────
# Shakti Textiles — environment variables (template)
#
# LOCAL:  cp .env.example server/.env   (server isi ko padhta hai)
#         (.env git me NAHI jata — ye sirf template hai)
#
# RENDER: Dashboard → Environment → "Add from .env" me neeche
#         wala RENDER PRODUCTION block paste karo.
# ─────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════
# RENDER PRODUCTION — Render env me YE block paste karo
# (JWT_SECRET ki value khud ka lamba random string daal do —
#  Render ke "Generate" button se bhi bana sakte ho)
# ═════════════════════════════════════════════════════════════
NODE_ENV=production
JWT_SECRET=isko-badal-do-lamba-random-secret-daalo
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@shaktitextiles.com
ADMIN_PASSWORD=ApnaStrongPasswordYahanDaalo
ADMIN_NAME=Shakti Admin
CLIENT_ORIGIN=https://YOUR-APP-NAME.onrender.com

# Data permanent karne ke liye MongoDB Atlas (free M0) — abhi
# optional, set na ho to file-store chalta hai (redeploy pe reset).
MONGODB_URI=
# ──────────── RENDER PRODUCTION block khatam ────────────


# ═══ LOCAL DEVELOPMENT (server/.env me is tarah use hota hai) ═══
# PORT=5000
# NODE_ENV=development
# JWT_SECRET=dev-only-secret-change-me
# ADMIN_EMAIL=admin@shaktitextiles.com
# ADMIN_PASSWORD=ChangeMe!2026
# ADMIN_NAME=Shakti Admin
# CLIENT_ORIGIN=http://localhost:5173
# MONGODB_URI=

# ── SMTP (optional; unset hone par emails console me log hote hain) ──
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Shakti Textiles <sales@shaktitextiles.com>
# ENQUIRY_NOTIFY_EMAIL=sales@shaktitextiles.com
