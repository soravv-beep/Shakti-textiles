# ── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ───────────────────────────────────────────
# Leave unset / empty to run with the built-in in-memory store.
MONGODB_URI=

# ── Auth (admin) ───────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=st_admin_token

# Seed admin (used by `npm run seed`)
ADMIN_EMAIL=admin@shaktitextiles.com
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_NAME=Shakti Admin

# ── CORS ───────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# ── SMTP (optional; logs emails to console when unset) ─
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Shakti Textiles <sales@shaktitextiles.com>"
ENQUIRY_NOTIFY_EMAIL=sales@shaktitextiles.com

# ── WhatsApp deep link used by the site widget ────────
WHATSAPP_NUMBER=919876543210
