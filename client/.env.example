# Client (Vite) env vars — VITE_ prefix zaroori hai, warna bundle me nahi jate.
# NOTE: ye values BUILD time pe bundle ho jati hain — badalne ke liye rebuild chahiye.

# Same-origin deploy (Render single service) me KHAALI chhodo —
# client apne aap same domain pe API hit karega.
# Alag API domain ho tabhi set karo, e.g. https://api.example.com
VITE_API_URL=

# WhatsApp widget ka number (country code ke sath, + ya spaces ke bina)
VITE_WHATSAPP_NUMBER=917015483332
